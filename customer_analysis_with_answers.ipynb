   "source": [
    "## Question 10: High-Value Customers\n",
    "**Top income earners and their profiles**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "query = \"\"\"\n",
    "SELECT \n",
    "    customer_id,\n",
    "    full_name,\n",
    "    bank_name,\n",
    "    occupation,\n",
    "    annual_income,\n",
    "    EXTRACT(YEAR FROM CURRENT_DATE) - EXTRACT(YEAR FROM date_of_birth) as age,\n",
    "    primary_source_of_funds,\n",
    "    country_of_residence\n",
    "FROM customers\n",
    "WHERE annual_income IS NOT NULL\n",
    "ORDER BY annual_income DESC\n",
    "LIMIT 10\n",
    "\"\"\"\n",
    "con.execute(query).df()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Bonus Challenge 1: Risk Segmentation\n",
    "**Customer risk profiles**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "query = \"\"\"\n",
    "SELECT \n",
    "    CASE \n",
    "        WHEN annual_income > 50000 AND primary_source_of_funds = 'Salary' THEN 'Low Risk'\n",
    "        WHEN annual_income > 30000 AND primary_source_of_funds IN ('Salary', 'Pension') THEN 'Medium Risk'\n",
    "        WHEN primary_source_of_funds = 'State benefits' OR annual_income < 10000 THEN 'High Risk'\n",
    "        ELSE 'Medium Risk'\n",
    "    END as risk_segment,\n",
    "    COUNT(*) as customer_count,\n",
    "    ROUND(AVG(annual_income), 2) as avg_income,\n",
    "    ROUND(COUNT(*) * 100.0 / SUM(COUNT(*)) OVER(), 2) as percentage\n",
    "FROM customers\n",
    "WHERE annual_income IS NOT NULL AND primary_source_of_funds IS NOT NULL\n",
    "GROUP BY risk_segment\n",
    "ORDER BY customer_count DESC\n",
    "\"\"\"\n",
    "df = con.execute(query).df()\n",
    "print(df)\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "plt.pie(df['customer_count'], labels=df['risk_segment'], autopct='%1.1f%%', startangle=90)\n",
    "plt.title('Customer Risk Segmentation')\n",
    "plt.axis('equal')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Bonus Challenge 2: Churn Analysis\n",
    "**Customers who left (have end_date)**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "query = \"\"\"\n",
    "SELECT \n",
    "    bank_name,\n",
    "    COUNT(*) as total_customers,\n",
    "    SUM(CASE WHEN end_date IS NOT NULL THEN 1 ELSE 0 END) as churned_customers,\n",
    "    ROUND(SUM(CASE WHEN end_date IS NOT NULL THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2) as churn_rate\n",
    "FROM customers\n",
    "GROUP BY bank_name\n",
    "\"\"\"\n",
    "print('Churn Rate by Bank:')\n",
    "print(con.execute(query).df())\n",
    "\n",
    "# Churned customer profiles\n",
    "query2 = \"\"\"\n",
    "SELECT \n",
    "    occupation,\n",
    "    COUNT(*) as churned_count,\n",
    "    ROUND(AVG(annual_income), 2) as avg_income,\n",
    "    ROUND(AVG(EXTRACT(YEAR FROM end_date) - EXTRACT(YEAR FROM start_date)), 1) as avg_tenure_before_churn\n",
    "FROM customers\n",
    "WHERE end_date IS NOT NULL\n",
    "GROUP BY occupation\n",
    "ORDER BY churned_count DESC\n",
    "LIMIT 10\n",
    "\"\"\"\n",
    "print('\\nChurned Customer Profiles:')\n",
    "con.execute(query2).df()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Bonus Challenge 3: Data Quality\n",
    "**Missing and incomplete data analysis**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "query = \"\"\"\n",
    "SELECT \n",
    "    COUNT(*) as total_records,\n",
    "    SUM(CASE WHEN email IS NULL THEN 1 ELSE 0 END) as missing_email,\n",
    "    SUM(CASE WHEN phone_number IS NULL THEN 1 ELSE 0 END) as missing_phone,\n",
    "    SUM(CASE WHEN annual_income IS NULL THEN 1 ELSE 0 END) as missing_income,\n",
    "    SUM(CASE WHEN occupation IS NULL THEN 1 ELSE 0 END) as missing_occupation,\n",
    "    SUM(CASE WHEN last_kyc_date IS NULL THEN 1 ELSE 0 END) as missing_kyc_date,\n",
    "    SUM(CASE WHEN id_doc_expiry_date IS NULL THEN 1 ELSE 0 END) as missing_doc_expiry\n",
    "FROM customers\n",
    "\"\"\"\n",
    "print('Missing Data Summary:')\n",
    "df = con.execute(query).df()\n",
    "print(df)\n",
    "\n",
    "# Calculate percentages\n",
    "total = df['total_records'].iloc[0]\n",
    "print('\\nMissing Data Percentages:')\n",
    "for col in df.columns[1:]:\n",
    "    pct = (df[col].iloc[0] / total) * 100\n",
    "    print(f'{col}: {pct:.2f}%')"
   ]
  },
