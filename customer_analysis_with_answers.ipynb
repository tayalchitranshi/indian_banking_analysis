   "source": [
    "# Customer Data Analysis - Complete Solutions\n",
    "## Banking Customer Insights"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import duckdb\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "con = duckdb.connect('data.duckdb', read_only=True)\n",
    "pd.set_option('display.max_columns', None)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Question 1: Customer Demographics\n",
    "**What is the distribution of customers by bank?**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "query = \"\"\"\n",
    "SELECT \n",
    "    bank_name,\n",
    "    COUNT(*) as customer_count,\n",
    "    ROUND(COUNT(*) * 100.0 / SUM(COUNT(*)) OVER(), 2) as percentage\n",
    "FROM customers\n",
    "GROUP BY bank_name\n",
    "ORDER BY customer_count DESC\n",
    "\"\"\"\n",
    "df = con.execute(query).df()\n",
    "print(df)\n",
    "\n",
    "# Visualization\n",
    "plt.figure(figsize=(10, 6))\n",
    "plt.bar(df['bank_name'], df['customer_count'])\n",
    "plt.title('Customer Distribution by Bank')\n",
    "plt.xlabel('Bank Name')\n",
    "plt.ylabel('Number of Customers')\n",
    "plt.xticks(rotation=45)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Question 2: Age Analysis\n",
    "**Average age and retirement status**"
   ]
  }
 ],
 "metadata": {
  "kernelspec": {
   "display_name": "Python 3",
   "language": "python",
   "name": "python3"
  }
 },
 "nbformat": 4,
 "nbformat_minor": 2
}
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "query = \"\"\"\n",
    "SELECT \n",
    "    ROUND(AVG(EXTRACT(YEAR FROM CURRENT_DATE) - EXTRACT(YEAR FROM date_of_birth)), 1) as avg_age,\n",
    "    MIN(EXTRACT(YEAR FROM CURRENT_DATE) - EXTRACT(YEAR FROM date_of_birth)) as min_age,\n",
    "    MAX(EXTRACT(YEAR FROM CURRENT_DATE) - EXTRACT(YEAR FROM date_of_birth)) as max_age,\n",
    "    SUM(CASE WHEN occupation = 'Retired' THEN 1 ELSE 0 END) as retired_count,\n",
    "    SUM(CASE WHEN occupation != 'Retired' THEN 1 ELSE 0 END) as working_count\n",
    "FROM customers\n",
    "\"\"\"\n",
    "con.execute(query).df()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Question 3: Income Distribution\n",
    "**Income by occupation**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "query = \"\"\"\n",
    "SELECT \n",
    "    occupation,\n",
    "    COUNT(*) as customer_count,\n",
    "    ROUND(AVG(annual_income), 2) as avg_income,\n",
    "    ROUND(MIN(annual_income), 2) as min_income,\n",
    "    ROUND(MAX(annual_income), 2) as max_income\n",
    "FROM customers\n",
    "WHERE annual_income IS NOT NULL\n",
    "GROUP BY occupation\n",
    "ORDER BY avg_income DESC\n",
    "LIMIT 10\n",
    "\"\"\"\n",
    "df = con.execute(query).df()\n",
    "print(df)\n",
    "\n",
    "plt.figure(figsize=(12, 6))\n",
    "plt.barh(df['occupation'], df['avg_income'])\n",
    "plt.title('Average Income by Occupation (Top 10)')\n",
    "plt.xlabel('Average Annual Income (GBP)')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Question 4: Source of Funds\n",
    "**Primary sources by age group**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "query = \"\"\"\n",
    "SELECT \n",
    "    CASE \n",
    "        WHEN EXTRACT(YEAR FROM CURRENT_DATE) - EXTRACT(YEAR FROM date_of_birth) < 30 THEN '18-29'\n",
    "        WHEN EXTRACT(YEAR FROM CURRENT_DATE) - EXTRACT(YEAR FROM date_of_birth) < 40 THEN '30-39'\n",
    "        WHEN EXTRACT(YEAR FROM CURRENT_DATE) - EXTRACT(YEAR FROM date_of_birth) < 50 THEN '40-49'\n",
    "        WHEN EXTRACT(YEAR FROM CURRENT_DATE) - EXTRACT(YEAR FROM date_of_birth) < 60 THEN '50-59'\n",
    "        WHEN EXTRACT(YEAR FROM CURRENT_DATE) - EXTRACT(YEAR FROM date_of_birth) < 70 THEN '60-69'\n",
    "        ELSE '70+'\n",
    "    END as age_group,\n",
    "    primary_source_of_funds,\n",
    "    COUNT(*) as count\n",
    "FROM customers\n",
    "WHERE primary_source_of_funds IS NOT NULL\n",
    "GROUP BY age_group, primary_source_of_funds\n",
    "ORDER BY age_group, count DESC\n",
    "\"\"\"\n",
    "con.execute(query).df()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Question 5: Gender Distribution\n",
    "**Gender analysis and income gap**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "query = \"\"\"\n",
    "SELECT \n",
    "    bank_name,\n",
    "    gender,\n",
    "    COUNT(*) as customer_count,\n",
    "    ROUND(AVG(annual_income), 2) as avg_income\n",
    "FROM customers\n",
    "WHERE gender IS NOT NULL AND annual_income IS NOT NULL\n",
    "GROUP BY bank_name, gender\n",
    "ORDER BY bank_name, gender\n",
    "\"\"\"\n",
    "df = con.execute(query).df()\n",
    "print(df)\n",
    "\n",
    "# Overall gender income gap\n",
    "query2 = \"\"\"\n",
    "SELECT \n",
    "    gender,\n",
    "    COUNT(*) as count,\n",
    "    ROUND(AVG(annual_income), 2) as avg_income\n",
    "FROM customers\n",
    "WHERE gender IS NOT NULL\n",
    "GROUP BY gender\n",
    "\"\"\"\n",
    "print('\\nOverall Gender Income Analysis:')\n",
    "con.execute(query2).df()"
   ]
  }
 ]
}
,
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Question 6: Geographic Analysis\n",
    "**Top regions by customer count**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "query = \"\"\"\n",
    "SELECT \n",
    "    SUBSTRING(postcode, 1, POSITION(' ' IN postcode) - 1) as postcode_area,\n",
    "    COUNT(*) as customer_count,\n",
    "    ROUND(AVG(annual_income), 2) as avg_income\n",
    "FROM customers\n",
    "WHERE postcode IS NOT NULL\n",
    "GROUP BY postcode_area\n",
    "ORDER BY customer_count DESC\n",
    "LIMIT 15\n",
    "\"\"\"\n",
    "df = con.execute(query).df()\n",
    "print(df)\n",
    "\n",
    "plt.figure(figsize=(12, 6))\n",
    "plt.bar(df['postcode_area'], df['customer_count'])\n",
    "plt.title('Top 15 Postcode Areas by Customer Count')\n",
    "plt.xlabel('Postcode Area')\n",
    "plt.ylabel('Number of Customers')\n",
    "plt.xticks(rotation=45)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Question 7: KYC Compliance\n",
    "**Outdated KYC records (>3 years)**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "query = \"\"\"\n",
    "SELECT \n",
    "    bank_name,\n",
    "    COUNT(*) as total_customers,\n",
    "    SUM(CASE WHEN last_kyc_date < CURRENT_DATE - INTERVAL '3 years' THEN 1 ELSE 0 END) as outdated_kyc,\n",
    "    ROUND(SUM(CASE WHEN last_kyc_date < CURRENT_DATE - INTERVAL '3 years' THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2) as outdated_percentage\n",
    "FROM customers\n",
    "WHERE last_kyc_date IS NOT NULL\n",
    "GROUP BY bank_name\n",
    "\"\"\"\n",
    "con.execute(query).df()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Question 8: Document Expiry\n",
    "**Expired ID documents**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "query = \"\"\"\n",
    "SELECT \n",
    "    bank_name,\n",
    "    COUNT(*) as total_customers,\n",
    "    SUM(CASE WHEN id_doc_expiry_date < CURRENT_DATE THEN 1 ELSE 0 END) as expired_docs,\n",
    "    ROUND(SUM(CASE WHEN id_doc_expiry_date < CURRENT_DATE THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2) as expired_percentage\n",
    "FROM customers\n",
    "WHERE id_doc_expiry_date IS NOT NULL\n",
    "GROUP BY bank_name\n",
    "\"\"\"\n",
    "print('Expired Documents by Bank:')\n",
    "print(con.execute(query).df())\n",
    "\n",
    "# List some expired documents\n",
    "query2 = \"\"\"\n",
    "SELECT \n",
    "    customer_id,\n",
    "    full_name,\n",
    "    bank_name,\n",
    "    id_doc_type,\n",
    "    id_doc_expiry_date\n",
    "FROM customers\n",
    "WHERE id_doc_expiry_date < CURRENT_DATE\n",
    "ORDER BY id_doc_expiry_date\n",
    "LIMIT 10\n",
    "\"\"\"\n",
    "print('\\nSample Expired Documents:')\n",
    "con.execute(query2).df()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Question 9: Customer Tenure\n",
    "**How long customers have been with the bank**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "query = \"\"\"\n",
    "SELECT \n",
    "    bank_name,\n",
    "    ROUND(AVG(EXTRACT(YEAR FROM CURRENT_DATE) - EXTRACT(YEAR FROM start_date)), 1) as avg_tenure_years,\n",
    "    MIN(start_date) as oldest_customer_date,\n",
    "    MAX(start_date) as newest_customer_date\n",
    "FROM customers\n",
    "WHERE start_date IS NOT NULL\n",
    "GROUP BY bank_name\n",
    "\"\"\"\n",
    "print('Average Customer Tenure:')\n",
    "print(con.execute(query).df())\n",
    "\n",
    "# Tenure distribution\n",
    "query2 = \"\"\"\n",
    "SELECT \n",
    "    CASE \n",
    "        WHEN EXTRACT(YEAR FROM CURRENT_DATE) - EXTRACT(YEAR FROM start_date) < 5 THEN '0-5 years'\n",
    "        WHEN EXTRACT(YEAR FROM CURRENT_DATE) - EXTRACT(YEAR FROM start_date) < 10 THEN '5-10 years'\n",
    "        WHEN EXTRACT(YEAR FROM CURRENT_DATE) - EXTRACT(YEAR FROM start_date) < 20 THEN '10-20 years'\n",
    "        WHEN EXTRACT(YEAR FROM CURRENT_DATE) - EXTRACT(YEAR FROM start_date) < 30 THEN '20-30 years'\n",
    "        ELSE '30+ years'\n",
    "    END as tenure_group,\n",
    "    COUNT(*) as customer_count\n",
    "FROM customers\n",
    "WHERE start_date IS NOT NULL\n",
    "GROUP BY tenure_group\n",
    "ORDER BY tenure_group\n",
    "\"\"\"\n",
    "print('\\nTenure Distribution:')\n",
    "con.execute(query2).df()"
   ]
  }
 ]
}
